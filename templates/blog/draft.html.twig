{% extends 'profile_base.html.twig' %}

{% block title %}New Draft{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'blog/_seer_theme.html.twig' %}
{% endblock %}

{% block content %}
<div class="seer-page">
    <div class="container" style="max-width: 720px;">
        <p class="seer-label">Blog / New Draft</p>
        <h1 class="seer-title">Write</h1>
        <p class="seer-lede">
            Paste or write your draft below. Title is the only other thing you need —
            subtitle, summary, and the formatted post body are all guessed from the
            draft text and land on the edit screen for you to touch up before publishing.
        </p>

        {% for message in app.flashes('error') %}
            <div class="seer-alert">{{ message }}</div>
        {% endfor %}

        <form method="post" action="{{ path('profile_blog_draft') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('profile_blog_draft') }}">

            <div class="mb-4">
                <label for="title">Title</label>
                <input type="text" name="title" id="title" class="seer-field" value="{{ title|default('') }}" required autofocus>
            </div>

            <div class="mb-4">
                <label for="draft">Draft</label>
                <textarea name="draft" id="draft" class="seer-field" rows="20" required placeholder="Write or paste your draft here. Blank lines separate paragraphs. # for headings, - for bullet lists, **bold**, *italic*, and [links](https://...) all work.">{{ draft|default('') }}</textarea>
            </div>

            <button class="seer-btn seer-btn-primary" type="submit">Save Draft</button>
            <a href="{{ path('profile_blog_status') }}" class="seer-btn seer-btn-quiet">Cancel</a>
        </form>
    </div>
</div>
{% endblock %}
