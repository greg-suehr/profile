<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">

<style>
  .seer-page {
    --st-dark: #0a0a0a;
    --st-light: #f8f7f4;
    --st-accent: #c4a77d;
    --st-muted: #6b6b6b;
    --st-border: rgba(10, 10, 10, 0.08);
    --st-display: 'Instrument Serif', Georgia, serif;
    --st-body: 'DM Sans', system-ui, sans-serif;

    background: var(--st-light);
    color: var(--st-dark);
    font-family: var(--st-body);
    padding: 4rem 2rem 6rem;
    min-height: 70vh;
  }

  .seer-page .seer-label {
    font-family: var(--st-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--st-muted);
    margin-bottom: 0.75rem;
  }

  .seer-page h1.seer-title {
    font-family: var(--st-display);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
    color: var(--st-dark);
  }

  .seer-page .seer-lede {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--st-muted);
    max-width: 60ch;
    margin-bottom: 2.5rem;
  }

  .seer-page .seer-card {
    background: #fff;
    border: 1px solid var(--st-border);
    border-radius: 0;
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .seer-page .seer-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(10, 10, 10, 0.06);
  }

  .seer-page .seer-column-header {
    font-family: var(--st-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--st-dark);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--st-border);
  }

  .seer-page .seer-count {
