    font-size: 0.7rem;
    color: var(--st-muted);
    border: 1px solid var(--st-border);
    padding: 0.1rem 0.5rem;
  }

  .seer-page .seer-post-link {
    color: var(--st-dark);
    text-decoration: none;
    font-family: var(--st-body);
    font-size: 0.9375rem;
  }

  .seer-page .seer-post-link:hover {
    color: var(--st-accent);
  }

  .seer-page .seer-meta {
    font-size: 0.75rem;
    color: var(--st-muted);
