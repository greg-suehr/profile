    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--st-muted);
    display: block;
    margin-bottom: 0.5rem;
  }

  .seer-page .seer-field {
