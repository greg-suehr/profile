{% extends 'profile_base.html.twig' %}

{% block title %}Blog Status Board{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'blog/_seer_theme.html.twig' %}
{% endblock %}

{% block content %}
<div class="seer-page">
    <div class="container-fluid">
        <p class="seer-label text-center">Blog</p>
        <h1 class="seer-title text-center">Status Board</h1>
        <p class="seer-lede text-center mx-auto mb-4">
            Capture | Outlined | Drafting | Editing | Submitted
        </p>
        <p class="text-center mb-5">
            <a href="{{ path('profile_blog_draft') }}" class="seer-btn seer-btn-primary">+ New Draft</a>
        </p>

        <div class="row flex-nowrap" style="overflow-x: auto;">
            {% for status, column in columns %}
                <div class="col-md-3" style="min-width: 260px;">
                    <div class="seer-card mb-3">
                        <div class="seer-column-header">
                            <span>{{ column.label }}</span>
                            <span class="seer-count">{{ column.posts|length }}</span>
                        </div>
                        <div class="p-2" style="min-height: 120px;">
                            {% for post in column.posts %}
                                <div class="seer-card mb-2 p-2">
                                    <a href="{{ edit_urls[post.id] }}" class="seer-post-link">
                                        {{ post.title }}
                                    </a>
                                    <div class="seer-meta">
                                        Updated {{ post.updatedAt|date('M j, Y') }}
                                    </div>
                                </div>
                            {% else %}
                                <p class="seer-empty">Empty</p>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
