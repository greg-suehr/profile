{% extends 'profile_base.html.twig' %}

{% block title %}Blog Status Board{% endblock %}

{% block content %}
<div class="container-fluid mt-5">
    <h1 class="text-center mb-2">Blog Status Board</h1>
    <p class="text-center text-muted mb-5">
        Capture | Outlined | Drafting | Editing | Submitted
    </p>

    <div class="row flex-nowrap" style="overflow-x: auto;">
        {% for status, column in columns %}
            <div class="col-md-3" style="min-width: 260px;">
                <div class="card mb-3">
                    <div class="card-header text-center">
                        <strong>{{ column.label }}</strong>
                        <span class="badge bg-secondary">{{ column.posts|length }}</span>
                    </div>
                    <div class="card-body p-2" style="min-height: 120px;">
                        {% for post in column.posts %}
                            <div class="card mb-2 shadow-sm">
                                <div class="card-body p-2">
                                    <a href="{{ edit_urls[post.id] }}" class="text-dark text-decoration-none">
                                        {{ post.title }}
                                    </a>
                                    <div class="text-muted" style="font-size: 0.8em;">
                                        Updated {{ post.updatedAt|date('M j, Y') }}
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <p class="text-muted text-center" style="font-size: 0.85em;">Empty</p>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
