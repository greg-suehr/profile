{# Alternate (unused) Katzen 404: animated cat-paw counter scene. Kept for future reference.
   To use it, point the getkatzen entry in bundles/TwigBundle/Exception/error404.html.twig at "katzen_demo/404_counter.html.twig". #}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <title>Not found · Katzen</title>
  <style>
    :root {
      --bg: #F6F1EB;
      --ink: #5A4436;
      --dark: #2E241B;
      --gold: #E8B44B;
      --gold-soft: #F6D58A;
      --muted: #8a7a6b;
      --fur: #D49A55;
      --fur-dark: #B07636;
      --line: rgba(90, 68, 54, 0.18);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { min-height: 100%; }
    body {
      font-family: system-ui, 'Segoe UI', sans-serif;
      line-height: 1.6;
      color: var(--ink);
      background: var(--bg);
    }
    a { color: inherit; text-decoration: none; }

    .hero {
      background: linear-gradient(135deg, var(--dark) 0%, var(--ink) 100%);
      color: var(--bg);
      padding: 1.5rem 1.5rem 9rem;
    }
    .bar {
      max-width: 1000px; margin: 0 auto;
      display: flex; justify-content: space-between; align-items: center;
    }
    .wordmark { font-weight: 700; letter-spacing: .02em; font-size: 1.25rem; }
    .wordmark:hover { color: var(--gold); }
    .code {
      font-size: .75rem; letter-spacing: .2em; text-transform: uppercase;
      color: var(--gold-soft); opacity: .8;
    }
    .hero-copy { max-width: 1000px; margin: 3rem auto 0; }
    .hero-copy h1 {
      font-size: clamp(2rem, 5vw, 3.25rem);
      line-height: 1.1; font-weight: 700; max-width: 16ch;
    }
    .hero-copy p { margin-top: 1rem; max-width: 46ch; color: #d9cfc2; }

    .scene-wrap {
      max-width: 860px; margin: -7rem auto 0; padding: 0 1.5rem;
    }
    .scene {
      background: #fffdf9;
      border: 2px solid var(--dark);
      box-shadow: 0 18px 40px rgba(46, 36, 27, .18);
      overflow: hidden;
    }
    .scene svg { display: block; width: 100%; height: auto; }

    .details {
      max-width: 860px; margin: 2.5rem auto 4rem; padding: 0 1.5rem;
      display: grid; gap: 2rem;
    }
    @media (min-width: 720px) { .details { grid-template-columns: 1.1fr 1fr; align-items: start; } }

    .receipt {
      background: #fff;
      border: 1px dashed var(--line);
      padding: 1.25rem 1.5rem 1.5rem;
      font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
      font-size: .85rem;
      position: relative;
    }
    .receipt::after {
      content: ""; position: absolute; left: 0; right: 0; bottom: -8px; height: 8px;
      background: radial-gradient(circle at 6px 0, transparent 5px, #fff 5.5px) 0 0 / 12px 8px repeat-x;
    }
    .receipt h2 {
      font-size: .7rem; letter-spacing: .2em; text-transform: uppercase;
      color: var(--muted); font-weight: 600;
      border-bottom: 1px dashed var(--line); padding-bottom: .6rem; margin-bottom: .6rem;
    }
    .receipt dl { display: grid; grid-template-columns: auto 1fr; gap: .35rem 1.25rem; }
    .receipt dt { color: var(--muted); }
    .receipt dd { text-align: right; word-break: break-all; }
    .receipt .zero { color: #b5482f; font-weight: 700; }

    .next h2 { font-size: 1.35rem; color: var(--dark); line-height: 1.25; }
    .next p { margin: .75rem 0 1.5rem; }
    .actions { display: flex; flex-wrap: wrap; gap: .75rem; }
    .btn {
      display: inline-block; padding: .8rem 1.4rem; font-weight: 600;
      border: 2px solid var(--dark); transition: transform .15s, background .15s, color .15s;
    }
    .btn-primary { background: var(--gold); color: var(--dark); }
    .btn-primary:hover { background: var(--gold-soft); transform: translateY(-2px); }
    .btn-ghost:hover { background: var(--dark); color: var(--bg); }

    footer { text-align: center; color: var(--muted); font-size: .8rem; padding-bottom: 2.5rem; }

    /* ---------- the crime ---------- */
    .paw, .page, .pupil { transform-box: fill-box; }
    .paw   { animation: swipe 7s cubic-bezier(.45,.05,.35,1) infinite; }
    .page  { transform-origin: 100% 100%; animation: tumble 7s linear infinite; }
    .pupil { transform-origin: 50% 50%; animation: watch 7s ease-in-out infinite; }
    .tail  { transform-box: fill-box; transform-origin: 0% 100%; animation: flick 2.8s ease-in-out infinite; }
    .ear-l { transform-box: fill-box; transform-origin: 50% 100%; animation: twitch 7s ease-in-out infinite; }

    @keyframes swipe {
      0%, 6%   { transform: translateX(0); }
      20%      { transform: translateX(150px); }
      25%      { transform: translateX(132px); }
      30%      { transform: translateX(150px); }
      46%      { transform: translateX(262px); }
      52%      { transform: translateX(255px); }
      78%, 100%{ transform: translateX(0); }
    }
    @keyframes tumble {
      0%, 30%  { transform: translate(0, 0) rotate(0); opacity: 1; }
      46%      { transform: translate(112px, 0) rotate(0); }
      51%      { transform: translate(122px, 8px) rotate(38deg); animation-timing-function: cubic-bezier(.5,0,1,.6); }
      60%      { transform: translate(138px, 134px) rotate(90deg); }
      63%      { transform: translate(141px, 128px) rotate(86deg); }
      66%      { transform: translate(142px, 134px) rotate(90deg); opacity: 1; }
      88%      { transform: translate(142px, 134px) rotate(90deg); opacity: 0; }
      89%      { transform: translate(0, 0) rotate(0); opacity: 0; }
      100%     { transform: translate(0, 0) rotate(0); opacity: 1; }
    }
    @keyframes watch {
      0%, 14%  { transform: translate(0, 0); }
      22%, 46% { transform: translate(5px, 0); }
      58%, 76% { transform: translate(6px, 4px); }
      90%, 100%{ transform: translate(-1px, 0); }
    }
    @keyframes flick {
      0%, 100% { transform: rotate(-6deg); }
      50%      { transform: rotate(10deg); }
    }
    @keyframes twitch {
      0%, 60%, 64%, 100% { transform: rotate(0); }
      62% { transform: rotate(-12deg); }
    }

    @media (prefers-reduced-motion: reduce) {
      .paw, .page, .pupil, .tail, .ear-l { animation: none; }
      .paw  { transform: translateX(262px); }
      .page { transform: translate(122px, 8px) rotate(38deg); }
    }
  </style>
</head>
<body>
  <header class="hero">
    <div class="bar">
      <a class="wordmark" href="/">Katzen</a>
      <span class="code">Error 404</span>
    </div>
    <div class="hero-copy">
      <h1>Someone knocked this page off the counter.</h1>
      <p>We checked the pantry, the walk-in, and under the fridge. It isn't here. The cat looks very pleased with itself.</p>
    </div>
  </header>

  <div class="scene-wrap">
    <div class="scene">
      <svg viewBox="0 0 600 320" role="img" aria-labelledby="scene-title">
        <title id="scene-title">A cat peeks over a kitchen counter and paws a page labelled 404 off the edge.</title>
        <defs>
          <clipPath id="above-counter"><rect x="0" y="0" width="600" height="170"/></clipPath>
          <pattern id="tile" width="40" height="40" patternUnits="userSpaceOnUse">
            <rect width="40" height="40" fill="#fffdf9"/>
            <path d="M40 0H0V40" fill="none" stroke="#efe6da" stroke-width="2"/>
          </pattern>
        </defs>

        <!-- backsplash + floor -->
        <rect width="600" height="320" fill="url(#tile)"/>
        <rect y="306" width="600" height="14" fill="#e9dfd2"/>

        <!-- jar + rolling pin for kitchen-ness -->
        <g opacity=".9">
          <rect x="228" y="118" width="40" height="52" rx="6" fill="#f3e6cf" stroke="#c9b597" stroke-width="2"/>
          <rect x="224" y="110" width="48" height="12" rx="3" fill="#B07636"/>
          <text x="248" y="150" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" font-weight="700" fill="#8a7a6b">FLOUR</text>
        </g>

        <!-- counter -->
        <rect x="0" y="170" width="420" height="16" fill="#5A4436"/>
        <rect x="0" y="186" width="410" height="120" fill="#7a5d48"/>
        <rect x="18" y="200" width="180" height="92" fill="none" stroke="#5A4436" stroke-width="3"/>
        <rect x="214" y="200" width="180" height="92" fill="none" stroke="#5A4436" stroke-width="3"/>
        <rect x="176" y="236" width="10" height="22" rx="3" fill="#E8B44B"/>
        <rect x="226" y="236" width="10" height="22" rx="3" fill="#E8B44B"/>

        <!-- the page -->
        <g class="page">
          <rect x="300" y="80" width="70" height="90" rx="2" fill="#fff" stroke="#c9b597" stroke-width="2"/>
          <text x="335" y="114" text-anchor="middle" font-family="system-ui, sans-serif" font-size="22" font-weight="800" fill="#5A4436">404</text>
          <rect x="312" y="126" width="46" height="4" rx="2" fill="#e5d8c6"/>
          <rect x="312" y="136" width="38" height="4" rx="2" fill="#e5d8c6"/>
          <rect x="312" y="146" width="42" height="4" rx="2" fill="#e5d8c6"/>
          <rect x="312" y="156" width="28" height="4" rx="2" fill="#e5d8c6"/>
        </g>

        <!-- the paw (lies on the counter, slides out from behind the head) -->
        <g class="paw">
          <rect x="-150" y="148" width="290" height="22" rx="11" fill="#D49A55"/>
          <path d="M-20 150 q6 10 0 20 M20 150 q6 10 0 20 M60 150 q6 10 0 20" stroke="#B07636" stroke-width="5" fill="none" stroke-linecap="round"/>
          <ellipse cx="140" cy="159" rx="18" ry="13" fill="#D49A55"/>
          <circle cx="152" cy="150" r="6" fill="#D49A55"/>
          <circle cx="156" cy="160" r="6" fill="#D49A55"/>
          <circle cx="150" cy="169" r="5.5" fill="#D49A55"/>
          <circle cx="152" cy="160" r="2.4" fill="#E9A8A0"/>
        </g>

        <!-- the culprit, peeking over the counter -->
        <g clip-path="url(#above-counter)">
          <path class="tail" d="M24 168 C 10 130, 30 104, 14 84" stroke="#B07636" stroke-width="12" fill="none" stroke-linecap="round"/>
          <g class="ear-l"><path d="M64 140 L72 96 L102 128 Z" fill="#D49A55"/><path d="M74 132 L76 108 L92 126 Z" fill="#E9A8A0"/></g>
          <path d="M150 128 L172 94 L178 140 Z" fill="#D49A55"/>
          <path d="M156 128 L170 106 L172 134 Z" fill="#E9A8A0"/>
          <ellipse cx="120" cy="178" rx="64" ry="54" fill="#D49A55"/>
          <path d="M100 126 q4 10 0 18 M120 124 q4 10 0 18 M140 126 q4 10 0 18" stroke="#B07636" stroke-width="5" fill="none" stroke-linecap="round"/>
          <ellipse cx="98" cy="160" rx="11" ry="12" fill="#F6D58A"/>
          <ellipse cx="142" cy="160" rx="11" ry="12" fill="#F6D58A"/>
          <ellipse class="pupil" cx="98" cy="160" rx="3.2" ry="9" fill="#2E241B"/>
          <ellipse class="pupil" cx="142" cy="160" rx="3.2" ry="9" fill="#2E241B"/>
        </g>
      </svg>
    </div>
  </div>

  <main class="details">
    <section class="receipt" aria-label="Inventory count">
      <h2>Stock count · Counter</h2>
      <dl>
        <dt>Item</dt>      <dd>{{ requested_path|default('this page') }}</dd>
        <dt>On hand</dt>   <dd class="zero">0</dd>
        <dt>Last seen</dt> <dd>Right on the edge</dd>
        <dt>Variance</dt>  <dd>−1 page</dd>
        <dt>Suspect</dt>   <dd>Orange. Unrepentant.</dd>
      </dl>
    </section>

    <section class="next">
      <h2>Let's get you back to the kitchen.</h2>
      <p>The link may be old, or the page may have moved. Everything else is right where we left it.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Back to Katzen</a>
        <a class="btn btn-ghost" href="/login">Sign in</a>
      </div>
    </section>
  </main>

  <footer>Katzen · software for kitchens that make things from scratch</footer>
</body>
</html>
