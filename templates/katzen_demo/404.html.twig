<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#F6F1EB">
  <title>Page not found · Katzen</title>
  <style>
    :root {
      --bg: #F6F1EB;
      --ink: #5A4436;
      --dark: #2E241B;
      --gold: #E8B44B;
      --gold-soft: #F6D58A;
      --gold-deep: #8A5A00;
      --muted: #6B5748;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      min-height: 100vh;
      font-family: system-ui, 'Segoe UI', sans-serif;
      line-height: 1.6;
      color: var(--ink);
      background: var(--bg);
      display: flex; flex-direction: column;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }
    a:focus-visible { outline: 3px solid var(--dark); outline-offset: 3px; }

    .bar { padding: 1.5rem; }
    .wordmark { font-weight: 700; font-size: 1.25rem; color: var(--dark); }
    .wordmark:hover { color: var(--gold-deep); }

    main {
      flex: 1;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center;
      padding: 1rem 1.5rem 4rem;
      animation: settle .8s ease-out both;
    }
    figure {
      width: min(460px, 100%);
      border: 2px solid var(--dark);
      overflow: hidden;
      margin-bottom: 2rem;
    }
    figure img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }

    .code {
      font-size: 1rem; font-weight: 700; letter-spacing: .25em;
      color: var(--gold-deep);
    }
    h1 {
      margin-top: .4rem;
      font-size: clamp(1.75rem, 4.5vw, 2.5rem); line-height: 1.2;
      color: var(--dark); max-width: 22ch;
    }
    p { margin: .75rem 0 2rem; max-width: 40ch; font-size: 1.125rem; color: var(--muted); }

    .btn {
      display: inline-block; padding: .85rem 1.75rem; font-weight: 700; font-size: 1.0625rem;
      background: var(--gold); color: var(--dark);
      border: 2px solid var(--dark);
      transition: background .15s, transform .15s;
    }
    .btn:hover { background: var(--gold-soft); transform: translateY(-2px); }

    @keyframes settle { from { opacity: 0; transform: translateY(8px); } }
    @media (prefers-reduced-motion: reduce) {
      main { animation: none; }
      .btn { transition: none; }
      .btn:hover { transform: none; }
    }
  </style>
</head>
<body>
  <header class="bar"><a class="wordmark" href="/">Katzen</a></header>

  <main>
    <figure>
      <img src="{{ asset('images/katzen-demo-restful-small.jpg') }}" alt="A cat lying on a sunlit wooden floor next to a stack of two metal teapots.">
    </figure>
    <span class="code">404</span>
    <h1>We can't find that page.</h1>
    <p>The link may be old, or the page may have moved.</p>
    <a class="btn" href="/">Back to Katzen</a>
  </main>
</body>
</html>
