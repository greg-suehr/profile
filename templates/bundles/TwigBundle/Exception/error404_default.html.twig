<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Page not found</title>
  <style>
    :root { --bg: #f8f7f4; --ink: #1a1a1a; --muted: #6b6b6b; }
    @media (prefers-color-scheme: dark) { :root { --bg: #141312; --ink: #f0ece4; --muted: #9a968f; } }
    html, body { margin: 0; min-height: 100%; background: var(--bg); color: var(--ink); }
    body {
      min-height: 100vh; display: grid; place-items: center; padding: 2rem; box-sizing: border-box;
      font-family: system-ui, sans-serif; text-align: center;
    }
    h1 { font-size: clamp(4rem, 14vw, 7rem); margin: 0; line-height: 1; letter-spacing: -.04em; }
    p { color: var(--muted); margin: 1rem 0 2rem; }
    a { color: var(--ink); font-weight: 600; }
  </style>
</head>
<body>
  <main>
    <h1>404</h1>
    <p>This page isn't here.</p>
    <a href="/">Go to the home page</a>
  </main>
</body>
</html>
