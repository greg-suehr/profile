{# templates/plays.html.twig #}
{% extends 'profile_base.html.twig' %}

{% block title %}Greg Suehr | Plays{% endblock %}

{% block content %}
<section class="hero-section">
  <div class="container">
    <h1 class="mb-3"><strong>Past Work</strong></h1>
    <p class="text-secondary-dark mb-0">
      A selection of productions and scripts-in-motion. For licensing, readings, or materials, please get in touch.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    {% if plays is empty %}
      <p class="text-secondary-dark">No plays published yet — check back soon.</p>
    {% else %}
    <div class="row g-4">
      {% for play in plays %}
        <div class="col-12 col-md-6 col-lg-4">
          <article class="card h-100 border-0 shadow-sm">
            {% if play.image %}
              <img src="{{ asset(play.image) }}" alt="{{ play.title }}" class="card-img-top img-fluid">
            {% endif %}
            <div class="card-body d-flex flex-column">
              <h3 class="h5 mb-2">
                <a href="{{ path('profile_play_show', {slug: play.slug}) }}" class="stretched-link text-decoration-none">
                  {{ play.title }}
                </a>
              </h3>
              {% if play.blurb %}
                <p class="text-secondary-dark mb-0">{{ play.blurb }}</p>
              {% endif %}
            </div>
          </article>
        </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
{% endblock %}
