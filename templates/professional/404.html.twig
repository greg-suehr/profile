<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#2E241B">
  <title>Page not found · Greg Suehr</title>
  <style>
    :root {
      --bg: #2E241B;
      --text: #D9D2C3;
      --light: #F6F1EB;
      --accent: #F6D58A;
      --hairline: rgba(246, 241, 235, 0.14);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { background: var(--bg); }
    body {
      font-family: system-ui, 'Segoe UI', sans-serif;
      line-height: 1.6;
      color: var(--text);
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--light); text-decoration: none; transition: color .2s; }
    a:hover, a:focus-visible { color: var(--accent); }
    a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 2px; }

    .page {
      min-height: 100vh; max-width: 960px; margin: 0 auto;
      padding: 2.5rem 1.5rem 2rem;
      display: flex; flex-direction: column;
    }

    .mark { font-size: 1.125rem; font-weight: 700; letter-spacing: .01em; }
    .mark a { color: var(--light); }
    .mark a:hover { color: var(--accent); }

    .stage {
      flex: 1; display: flex; flex-direction: column;
      align-items: center; justify-content: center; text-align: center;
      padding: 3rem 0;
    }
    .code {
      font-size: clamp(6.5rem, 26vw, 15rem); font-weight: 800; line-height: .85;
      letter-spacing: -.04em; color: var(--light);
    }
    .code span { color: var(--accent); }
    h1 {
      margin-top: 2rem;
      font-size: clamp(1.5rem, 4vw, 2.125rem); font-weight: 600; line-height: 1.25;
      color: var(--light);
    }
    .lede { margin-top: .75rem; font-size: 1.125rem; max-width: 30rem; }

    .home {
      display: inline-flex; align-items: center; gap: .6rem; margin-top: 2.25rem;
      padding: .85rem 1.6rem; border-radius: 9999px;
      background: var(--accent); color: var(--bg);
      font-weight: 700; font-size: 1rem;
      transition: background .2s, transform .2s;
    }
    .home:hover, .home:focus-visible { background: var(--light); color: var(--bg); }
    .home svg { width: 1.1rem; height: 1.1rem; transition: transform .2s; }
    .home:hover svg { transform: translateX(4px); }

    footer { border-top: 1px solid var(--hairline); padding-top: 1.5rem; }
    footer ul {
      list-style: none; display: flex; flex-wrap: wrap; justify-content: center;
      gap: .5rem 1.75rem;
    }
    footer a { font-size: .9375rem; color: var(--text); }
    footer a:hover, footer a:focus-visible { color: var(--accent); }

    @media (prefers-reduced-motion: reduce) {
      * { transition: none !important; }
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="mark"><a href="/">Greg Suehr</a></div>

    <main class="stage">
      <p class="code" aria-hidden="true">4<span>0</span>4</p>
      <h1>Page not found</h1>
      <p class="lede">This page doesn't exist, or it has moved.</p>
      <a class="home" href="/">
        Back to the front page
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </main>

    <footer>
      <ul>
        <li><a href="/#about">About</a></li>
        <li><a href="/#experience">Experience</a></li>
        <li><a href="/#projects">Projects</a></li>
        <li><a href="/research">Research</a></li>
        <li><a href="/archive">Archive</a></li>
        <li><a href="/reading">Reading</a></li>
        <li><a href="/etal">Acknowledgements</a></li>
      </ul>
    </footer>
  </div>
</body>
</html>
